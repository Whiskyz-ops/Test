{
  "name": "wising-monitor-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:engine": "node scripts/sync-engine.js",
    "sync:dag": "node scripts/sync-dag.js",
    "sync:dag-py": "node scripts/sync-dag-py.js",
    "build:docs": "node scripts/build-docs.js",
    "build:dag-wheel": "python3 ../scripts/build-dag-wheel.py",
    "predev": "node scripts/embed-font.js && node scripts/sync-engine.js && node scripts/sync-dag.js && node scripts/sync-dag-py.js && node scripts/build-docs.js",
    "prebuild": "node scripts/embed-font.js && node scripts/sync-engine.js && node scripts/sync-dag.js && npm run build:dag-wheel && node scripts/sync-dag-py.js && node scripts/build-docs.js",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/manrope": "^5.2.8",
    "@vercel/analytics": "^2.0.1",
    "@xstate/react": "^6.1.0",
    "lucide-react": "^1.23.0",
    "next": "14.2.33",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-simple-maps": "3.0.0",
    "us-atlas": "3.0.1",
    "world-atlas": "2.0.2",
    "xstate": "^5.32.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "vitest": "^2.1.8"
  }
}
