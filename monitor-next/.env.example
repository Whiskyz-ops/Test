# ── UAT (User Assessment Testing) analytics ─────────────────────────────────
# Copy to `.env.local` for a UAT build. Both are OFF/blank by default, so a
# normal build tracks nothing.

# Turn on in-app usage tracking. "1" = on. Leave unset/blank for production.
NEXT_PUBLIC_UAT_ENABLED=

# Optional: forward each event to a collector you control. Examples:
#   - a Google Apps Script web-app URL (free, no account beyond Google)
#   - a PostHog capture endpoint
#   - your own /collect endpoint
# Leave blank to only buffer events in the browser (pull them with
# window.__uat.export() in the console at the end of a session).
NEXT_PUBLIC_UAT_ANALYTICS_URL=
