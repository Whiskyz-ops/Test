{
  "name": "wising-india-us-tax-conflict",
  "version": "0.1.0",
  "description": "India-US cross-border tax conflict detection prototype: Layer 1 intake forms feed a Layer 2 computation + conflict engine and dashboard.",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i assets/tailwind.input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i assets/tailwind.input.css -o assets/tailwind.css --watch",
    "build:dag-bundle": "node scripts/build-dag-bundle.js",
    "build:dag-wheel": "python3 scripts/build-dag-wheel.py",
    "serve": "python3 -m http.server 8099",
    "engine:demo": "node -e 'global.window=global;const {resolveEngineFile}=require(\"./scripts/engine-frozen.js\");[\"constants\",\"normalize\",\"computation\",\"monitoring\",\"conflicts\",\"sample-data\",\"profiles\"].forEach(m=>require(resolveEngineFile(m+\".js\")));const S=window.WISING.SAMPLE;console.log(JSON.stringify(window.WISING.analyze({router:S.router,india:S.india,us:S.us}).summary,null,2))'",
    "test": "node tests/engine/run.js",
    "audit:handlers": "node scripts/audit/dom-handler-coverage.js",
    "audit:fields": "node scripts/audit/field-coverage.js",
    "audit:arrays": "node scripts/audit/array-item-coverage.js",
    "audit:e2e": "node scripts/audit/e2e-field-sweep.js",
    "audit:steps": "node scripts/audit/step-reachability.js",
    "audit:options": "node scripts/audit/option-value-coverage.js",
    "audit:output": "node scripts/audit/engine-output-frontend-coverage.js",
    "audit:dag": "node scripts/audit/dag-coverage.js",
    "audit": "npm run audit:handlers && npm run audit:fields && npm run audit:arrays && npm run audit:steps && npm run audit:options && npm run audit:output && npm run audit:dag",
    "fuzz:dag": "node prototypes/graph-pilot/run-fuzz.js",
    "port:dag-py-profiles": "node dag_py/tools/port_profiles.js",
    "golden:dag-py": "node dag_py/tools/generate_golden.js",
    "fuzz:dag-py-corpus": "node prototypes/graph-pilot/run-fuzz.js --mode=corpus",
    "test:dag-py": "cd dag_py && pytest -q",
    "compare:js-vs-py-dag": "node prototypes/graph-pilot/run-js-dag-vs-py-dag.js",
    "merge:find-base": "node scripts/merge/find-base-commit.js",
    "merge:apply": "node scripts/merge/three-way-merge.js",
    "audit:fix-regression": "node scripts/audit/fix-regression-check.js"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:41729/git/Whiskyz-ops/Test"
  },
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "esbuild": "^0.28.1",
    "tailwindcss": "^3.4.17"
  }
}
